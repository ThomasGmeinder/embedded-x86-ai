<mujoco model="so101 pick place">
  <include file="so101.xml"/>

  <statistic center="0.25 0 0.12" extent="0.6"/>

  <visual>
    <headlight diffuse="0.55 0.55 0.55" ambient="0.45 0.45 0.45" specular="0.02 0.02 0.02"/>
    <rgba haze="0.85 0.88 0.9 1"/>
    <global azimuth="180" elevation="-90" offwidth="640" offheight="480"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.78 0.78 0.78" rgb2="0.62 0.62 0.62"
      width="512" height="3072"/>
    <texture type="2d" name="table_tex" builtin="flat" rgb1="0.90 0.90 0.90" rgb2="0.90 0.90 0.90"
      width="512" height="512"/>
    <material name="table_mat" texture="table_tex" texuniform="true" rgba="0.90 0.90 0.90 1"/>
    <material name="box_mat" rgba="0.12 0.12 0.12 1" specular="0.05"/>
    <material name="cube_mat" rgba="0.612 0.733 0.820 1" specular="0.1"/>
  </asset>

  <worldbody>
    <light name="ceiling" pos="0.25 0 1.4" dir="0 0 -1" directional="true" diffuse="0.7 0.7 0.7"
      specular="0.02 0.02 0.02" castshadow="true"/>

    <geom name="floor" type="plane" pos="0 0 -0.4" size="0 0 0.05" rgba="0.75 0.75 0.75 1"/>

    <body name="table" pos="0.22 0 -0.02">
      <geom name="table_top" type="box" size="0.40 0.32 0.02" material="table_mat"/>
    </body>

    <!-- KIT top optical frame on base_link, plus the published (-0.002, 0.027, 0) shift. -->
    <camera name="top" mode="fixed" pos="0.0490126 0.121504 0.528474"
      quat="0.693521 0.137949 -0.137948 -0.693519" fovy="59.17"/>

    <body name="place_box" pos="0.249 0.071 0.025">
      <geom name="box_bottom" type="box" size="0.05 0.05 0.004" pos="0 0 0" material="box_mat"
        friction="1.2 0.02 0.001"/>
      <geom name="box_xp" type="box" size="0.004 0.05 0.025" pos="0.046 0 0.025" material="box_mat"/>
      <geom name="box_xn" type="box" size="0.004 0.05 0.025" pos="-0.046 0 0.025" material="box_mat"/>
      <geom name="box_yp" type="box" size="0.05 0.004 0.025" pos="0 0.046 0.025" material="box_mat"/>
      <geom name="box_yn" type="box" size="0.05 0.004 0.025" pos="0 -0.046 0.025" material="box_mat"/>
    </body>

    <body name="cube" pos="0.302 -0.037 0.02">
      <freejoint name="cube_joint"/>
      <geom name="cube_geom" type="box" size="0.02 0.02 0.02" mass="0.04" material="cube_mat"
        friction="1.4 0.02 0.002" condim="4" solref="0.01 1"/>
    </body>
  </worldbody>
