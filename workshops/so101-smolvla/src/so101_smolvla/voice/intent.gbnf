# Grammar for the intent router: the model can ONLY emit a JSON list of four strings,
#   ["<one of the known commands>", "<object: 0-3 plain words>", "<place: 0-2 plain words>", "<the words heard>"]
# so JSON parsing can never fail and unknown verbs collapse to "unknown".
# The fourth is what the speaker said, so the console can show it. The command, the object
# and the place come first: they are acted on while the words are still being written.
# A list and not an object with named keys: fewer tokens before the call is complete
# (TESTING_LEDGER.md, 2026-11-23).

root    ::= "[" ws cmd ws "," ws obj ws "," ws place ws "," ws said ws "]"

cmd     ::= "\"gesture_mimic\"" | "\"fetch_block\"" | "\"pick_place\"" |
            "\"dance\"" | "\"grip\"" | "\"release\"" | "\"wave\"" | "\"home\"" |
            "\"learn_stack\"" | "\"rebuild_stack\"" |
            "\"stop\"" | "\"unknown\""

# Object: empty, or 1-3 lowercase words ("ball", "water bottle", "small green bottle").
obj     ::= "\"\"" | "\"" word (" " word)? (" " word)? "\""
# Place: empty, or 1-2 lowercase words ("box").
place   ::= "\"\"" | "\"" word (" " word)? "\""
word    ::= [a-z] [a-z]{0,15}

# What was said. Empty when the words cannot be made out.
# The rule is not named heard_*: the grammar lexer splits that into the
# "heard" key plus leftover text, and a quote inside [^"] ends the string.
said  ::= "\"" hchar* "\""
hchar ::= [a-zA-Z0-9] | "'" | "," | "." | "?" | "!" | "-" | " "

ws      ::= [ \t]*
