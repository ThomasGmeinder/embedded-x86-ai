# =============================================================================
# Workshop-specific
# =============================================================================

# Cursor AI context — kept locally, not for public repo
.cursorrules
AGENTS.md

# Workshop slides — kept locally, not for public repo
slides/

# Planning docs — kept locally, not for public repo
INT8_BONUS_PLAN.md

# VAIML compile cache — machine-specific binaries, too large for git (~600 MB+)
# Keep the folder tracked via its README + portable pass config, ignore the binaries.
cache/*
!cache/README.md
!cache/vitisai_config.json

# Exported ONNX and PyTorch weights — regenerated by running the notebook
notebook/*.onnx
notebook/*.pt
notebook/original-*-signature.txt

# Root-level model weights (downloaded/regenerated, too large for git)
/yolo26s.pt

# Ultralytics signature files (root and notebook/)
original-*-signature.txt
notebook/original-*-signature.txt

# Notebook generator — superseded by hand-edited always_on_physical_ai.ipynb
notebook/build_notebook.py

# Assets — keep only sample.jpg, sample_video.mp4, and teleop_sample.mp4
assets/*
!assets/sample.jpg
!assets/sample_video.mp4
!assets/teleop_sample.mp4

# Test-execution artifact from nbconvert
notebook/_executed.ipynb

# MuJoCo runtime log (generated on every render)
MUJOCO_LOG.TXT
notebook/MUJOCO_LOG.TXT

# Reference and dev materials — kept locally, not for public repo
Context/
context/
notes/

# Model weights: bundle the pre-built hand-landmark model so the workshop never
# depends on a runtime HuggingFace download (which can hang on shared wifi, ~10 MB).
# Everything else in models/ (other local binaries) stays out of git.
models/*
!models/hand_landmark.onnx

# Scripts not included in public repo
export_yolo26s_pose.py
pose_demo.py
quantize.py

# Generated outputs
quantized_info.csv

# NPU partition profiler output (regenerated by profile_npu_partition.py)
npu_partition_profile_*.json

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# =============================================================================
# Conda / virtualenv
# =============================================================================
.conda/
env/
venv/
.venv/

# =============================================================================
# IDE / editor
# =============================================================================
.vscode/
.idea/
*.swp
*.swo

# =============================================================================
# OS
# =============================================================================
Thumbs.db
.DS_Store
Desktop.ini

# =============================================================================
# Build / scratch
# =============================================================================
build/
dist/
*.log

# Local scratch area — candidate clips, install experiments, etc. Not for repo.
tmp/
