<?xml version="1.0" ?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>so_arm101_moveit_config</name>
  <version>0.1.0</version>
  <description>
    An automatically generated package with all the configuration and launch
    files for using the so_arm101 with the MoveIt Motion Planning Framework
  </description>
  <maintainer email="tgmeinde@amd.com">tgmeinde</maintainer>

  <license>BSD-3-Clause</license>

  <url type="website">http://moveit.ros.org/</url>
  <url type="bugtracker">https://github.com/moveit/moveit2/issues</url>
  <url type="repository">https://github.com/moveit/moveit2</url>

  <author email="tgmeinde@amd.com">tgmeinde</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>moveit_kinematics</exec_depend>
  <exec_depend>moveit_planners</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_setup_assistant</exec_depend>
  <exec_depend>moveit_simple_controller_manager</exec_depend>
  <exec_depend>moveit_task_constructor_capabilities</exec_depend>
  <exec_depend>parallel_gripper_controller</exec_depend>
  <exec_depend>pick_ik</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>so_arm101_description</exec_depend>
  <exec_depend>so_arm_utils</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
