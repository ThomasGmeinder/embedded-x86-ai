From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tgmeinde <tgmeinde@amd.com>
Date: Tue, 27 Oct 2026 22:50:00 +0100
Subject: [PATCH] so_arm101: wait until the arm reaches the trajectory goal

A goal tolerance of 0 leaves the check off, so the controller reports
success while shoulder_lift is still short of the last point. 0.01 rad
is the start tolerance MoveIt already uses. goal_time 0 waits until the
arm is there instead of ending when the trajectory clock does. A held
jaw chatters at about 0.02 rad/s, so the 0.001 rad/s default stall speed
never completes a held close; 0.05 is above that and far below the 2.5
rad/s close.

---

diff --git a/so_arm101_description/control/ros2_controllers.yaml b/so_arm101_description/control/ros2_controllers.yaml
index d6223d6..57de2a4 100644
--- a/so_arm101_description/control/ros2_controllers.yaml
+++ b/so_arm101_description/control/ros2_controllers.yaml
@@ -19,6 +19,7 @@ gripper_controller:
   ros__parameters:
     joint: <robot_namespace>gripper_joint
     allow_stalling: true
+    stall_velocity_threshold: 0.05
 
 
 joint_trajectory_controller:
@@ -34,6 +35,21 @@ joint_trajectory_controller:
       - <robot_namespace>elbow_flex_joint
       - <robot_namespace>wrist_flex_joint
       - <robot_namespace>wrist_roll_joint
+    # A goal tolerance of 0 disables the check, so a move that is still short
+    # is reported as success. 0.01 rad is the start tolerance MoveIt already
+    # uses. goal_time 0 waits until the arm is there.
+    constraints:
+      goal_time: 0.0
+      <robot_namespace>shoulder_pan_joint:
+        goal: 0.01
+      <robot_namespace>shoulder_lift_joint:
+        goal: 0.01
+      <robot_namespace>elbow_flex_joint:
+        goal: 0.01
+      <robot_namespace>wrist_flex_joint:
+        goal: 0.01
+      <robot_namespace>wrist_roll_joint:
+        goal: 0.01
 
 forward_position_controller:
   ros__parameters:
