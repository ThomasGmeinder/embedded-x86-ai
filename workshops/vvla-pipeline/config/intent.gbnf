# Grammar for the intent router: the model can ONLY emit
#   {"command": "<one of the known commands>", "object": "<0-2 plain words>", "heard": "<words>"}
# so JSON parsing can never fail and unknown verbs collapse to "unknown".
# "heard" is what the speaker said, so the console can show it.

root    ::= "{" ws "\"command\"" ws ":" ws cmd ws "," ws "\"object\"" ws ":" ws obj ws "," ws "\"heard\"" ws ":" ws said ws "}"

cmd     ::= "\"gesture_mimic\"" | "\"fetch_block\"" | "\"pick_place\"" |
            "\"dance\"" | "\"grip\"" | "\"release\"" | "\"wave\"" | "\"home\"" |
            "\"stop\"" | "\"unknown\""

# Object: empty, or 1-2 lowercase words ("ball", "water bottle").
obj     ::= "\"\"" | "\"" word (" " word)? "\""
word    ::= [a-z] [a-z]{0,15}

# What was said. Empty when the words cannot be made out.
# The rule is not named heard_*: the grammar lexer splits that into the
# "heard" key plus leftover text, and a quote inside [^"] ends the string.
said  ::= "\"" hchar* "\""
hchar ::= [a-zA-Z0-9] | "'" | "," | "." | "?" | "!" | "-" | " "

ws      ::= [ \t]*
